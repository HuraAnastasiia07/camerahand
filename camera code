def rot_mat(deg):
    a = np.deg2rad(deg)
    c, s = np.cos(a), np.sin(a)
    return np.array([[c, -s], [s, c]], dtype=np.float32)

def point_in_glass(px, py, cx, cy, w, h, angle):
    R = rot_mat(-angle)
    v = np.array([px - cx, py - cy], dtype=np.float32)
    lv = R @ v
    return abs(lv[0]) <= w / 2 and abs(lv[1]) <= h / 2

def rounded_rect_poly(cx, cy, w, h, angle, r, steps=6):
    hw, hh = w / 2, h / 2
    r = min(r, hw * 0.9, hh * 0.9)
    pts = []
    corners = [
        (hw - r, -hh + r, -90, 0),
        (hw - r,  hh - r, 0, 90),
        (-hw + r, hh - r, 90, 180),
        (-hw + r, -hh + r, 180, 270)
    ]
    for ccx, ccy, a0, a1 in corners:
        for t in np.linspace(a0, a1, steps):
            a = np.deg2rad(t)
            pts.append([ccx + r * np.cos(a), ccy + r * np.sin(a)])
    pts = np.array(pts, dtype=np.float32)
    R = rot_mat(angle)
    return (pts @ R.T) + np.array([cx, cy], dtype=np.float32)

def ang_diff(a, b):
    d = a - b
    while d > 180: d -= 360
    while d < -180: d += 360
    return d

FINGER_TIPS = [
    mp_hands.HandLandmark.THUMB_TIP,
    mp_hands.HandLandmark.INDEX_FINGER_TIP,
    mp_hands.HandLandmark.MIDDLE_FINGER_TIP,
    mp_hands.HandLandmark.RING_FINGER_TIP,
    mp_hands.HandLandmark.PINKY_TIP,
]
FINGER_PIPS = [
    mp_hands.HandLandmark.THUMB_IP,
    mp_hands.HandLandmark.INDEX_FINGER_PIP,
    mp_hands.HandLandmark.MIDDLE_FINGER_PIP,
    mp_hands.HandLandmark.RING_FINGER_PIP,
    mp_hands.HandLandmark.PINKY_PIP,
]

def count_extended_fingers(hand, fw, fh):
    wrist = hand.landmark[mp_hands.HandLandmark.WRIST]
    wx, wy = wrist.x * fw, wrist.y * fh
    mmcp = hand.landmark[mp_hands.HandLandmark.MIDDLE_FINGER_MCP]
    palm_size = max(np.hypot(mmcp.x * fw - wx, mmcp.y * fh - wy), 1.0)

    ext = []
    for tip_id, pip_id in zip(FINGER_TIPS, FINGER_PIPS):
        t = hand.landmark[tip_id]
        p = hand.landmark[pip_id]
        d_tip = np.hypot(t.x * fw - wx, t.y * fh - wy)
        d_pip = np.hypot(p.x * fw - wx, p.y * fh - wy)
        ext.append(1 if d_tip > d_pip * 1.05 else 0)

    thumb = hand.landmark[mp_hands.HandLandmark.THUMB_TIP]
    index_mcp = hand.landmark[mp_hands.HandLandmark.INDEX_FINGER_MCP]
    d_thumb = np.hypot(thumb.x * fw - index_mcp.x * fw,
                       thumb.y * fh - index_mcp.y * fh)
    ext[0] = 1 if d_thumb > palm_size * 0.6 else 0

    return int(sum(ext)), ext

class GlassItem:
    def __init__(self, cx, cy, w, h, angle=0.0):
        self.cx, self.cy = float(cx), float(cy)
        self.w, self.h = float(w), float(h)
        self.angle = float(angle)

        self.target_cx, self.target_cy = self.cx, self.cy
        self.target_w, self.target_h = self.w, self.h
        self.target_angle = self.angle

        self.vx, self.vy = 0.0, 0.0
        self.va = 0.0

        self.grabbed = False
        self.grab_anchor_local = np.zeros(2, dtype=np.float32)
        self.grab_start_w = self.w
        self.grab_start_h = self.h
        self.grab_start_angle = self.angle
        self.grab_start_dist = 1.0
        self.grab_start_hand_angle = 0.0
        self.grab_center_offset = np.zeros(2, dtype=np.float32)

        self.breath_phase = 0.0
        self.tilt = 0.0
        self.tilt_smooth = 0.0
        self.glow = 0.0

        self.fingers_used = 0
        self.gesture_name = "—"

    def current_w(self):
        return self.w * (1 + 0.003 * np.sin(self.breath_phase))

    def current_h(self):
        return self.h * (1 + 0.003 * np.cos(self.breath_phase * 0.9))

    def try_grab(self, px, py, pdist, hand_angle, fingers):
        if point_in_glass(px, py, self.cx, self.cy, self.w, self.h, self.angle):
            self.grabbed = True
            R = rot_mat(-self.angle)
            v = np.array([px - self.cx, py - self.cy], dtype=np.float32)
            self.grab_anchor_local = R @ v
            self.grab_start_dist = max(pdist, 1.0)
            self.grab_start_w = self.w
            self.grab_start_h = self.h
            self.grab_start_angle = self.angle
            self.grab_start_hand_angle = hand_angle
            self.fingers_used = fingers
            return True
        return False

    def update(self, dt, frame_w, frame_h):
        self.breath_phase += 0.03 * dt * 60
        self.tilt_smooth += (self.tilt - self.tilt_smooth) * SMOOTH_TILT

        target_glow = 1.0 if self.grabbed else 0.0
        self.glow += (target_glow - self.glow) * 0.15

        if self.grabbed:
            self.cx += (self.target_cx - self.cx) * SMOOTH_POS
            self.cy += (self.target_cy - self.cy) * SMOOTH_POS
            self.w  += (self.target_w  - self.w)  * SMOOTH_SIZE
            self.h  += (self.target_h  - self.h)  * SMOOTH_SIZE
            d = ang_diff(self.target_angle, self.angle)
            self.angle += d * SMOOTH_ANGLE

            self.vx *= 0.5
            self.vy *= 0.5
            self.va *= 0.5
        else:
            self.cx += self.vx
            self.cy += self.vy
            self.angle += self.va

            self.vx *= FRICTION
            self.vy *= FRICTION
            self.va *= ANG_FRICTION

            if abs(self.vx) < 0.03: self.vx = 0.0
            if abs(self.vy) < 0.03: self.vy = 0.0
            if abs(self.va) < 0.02: self.va = 0.0

            half_w = self.w / 2
            half_h = self.h / 2
            if self.cx - half_w < 0:
                self.cx = half_w
                self.vx = -self.vx * BOUNCE
            if self.cx + half_w > frame_w:
                self.cx = frame_w - half_w
                self.vx = -self.vx * BOUNCE
            if self.cy - half_h < 0:
                self.cy = half_h
                self.vy = -self.vy * BOUNCE
            if self.cy + half_h > frame_h:
                self.cy = frame_h - half_h
                self.vy = -self.vy * BOUNCE

            self.target_cx, self.target_cy = self.cx, self.cy
            self.target_w, self.target_h = self.w, self.h
            self.target_angle = self.angle

        sp = np.hypot(self.vx, self.vy)
        if sp > MAX_SPEED:
            self.vx *= MAX_SPEED / sp
            self.vy *= MAX_SPEED / sp
        if abs(self.va) > MAX_ANG_SPEED:
            self.va = np.sign(self.va) * MAX_ANG_SPEED

    def set_target_pos(self, px, py):
        R = rot_mat(self.angle)
        world_anchor = R @ self.grab_anchor_local + np.array([self.cx, self.cy], dtype=np.float32)
        dx = px - world_anchor[0]
        dy = py - world_anchor[1]
        self.target_cx = self.cx + dx
        self.target_cy = self.cy + dy

    def rotate_towards(self, target_angle):
        self.target_angle = target_angle

    def apply_flick(self, vx, vy, va=0.0, mult=1.0):
        self.vx = np.clip(vx * mult, -MAX_SPEED, MAX_SPEED)
        self.vy = np.clip(vy * mult, -MAX_SPEED, MAX_SPEED)
        self.va = np.clip(va * mult, -MAX_ANG_SPEED, MAX_ANG_SPEED)

